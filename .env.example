# GeM Price Comparison - Environment Variables
# Copy this file to .env and fill in your values

# NVIDIA NIM API Key (free at https://build.nvidia.com)
# Required for LLM-based attribute extraction
NVIDIA_API_KEY=nvapi-your-key-here

# NVIDIA NIM Settings
NVIDIA_BASE_URL=https://integrate.api.nvidia.com/v1
NVIDIA_MODEL=openai/gpt-oss-20b
NVIDIA_MIN_SECONDS_BETWEEN_CALLS=1.6
NVIDIA_MAX_TOKENS=700
NVIDIA_TEMPERATURE=0.0

# Embedding Model
EMBEDDING_MODEL=all-MiniLM-L6-v2

# Scraping Settings
GEM_MAX_RESULTS=20
FLIPKART_MAX_RESULTS=30
GEM_POLITE_DELAY_MIN=2.0
GEM_POLITE_DELAY_MAX=3.0
FLIPKART_PAGE_DELAY_MIN=1.0
FLIPKART_PAGE_DELAY_MAX=2.0
FLIPKART_SCROLL_COUNT=8
SELENIUM_PAGE_LOAD_TIMEOUT=45
SELENIUM_SCRIPT_TIMEOUT=30

# Matching Settings
COSINE_THRESHOLD=0.55
COMPOSITE_THRESHOLD=0.6
TOP_K_MATCHES=10

# API Settings
API_HOST=0.0.0.0
API_PORT=8000
API_REQUEST_TIMEOUT=30

# Database Settings
DB_FOREIGN_KEYS=true

# Logging
LOG_LEVEL=INFO
LOG_FORMAT="%(asctime)s | %(levelname)-8s | %(name)s | %(message)s"