# GeM Price Comparison — Environment Variables
# Copy this file to .env and fill in your values

# Required: NVIDIA API key for LLM calls (free tier at https://integrate.api.nvidia.com)
NVIDIA_API_KEY=your_key_here

# Optional: Override defaults
# NVIDIA_BASE_URL=https://integrate.api.nvidia.com/v1
# NVIDIA_MODELS=nvidia/nemotron-3-super-120b-a12b
# NVIDIA_MAX_TOKENS=2000
# NVIDIA_MIN_SECONDS_BETWEEN_CALLS=1.6
# NVIDIA_TIMEOUT_SECONDS=90.0

# Cache TTL in seconds (default: 3600 = 1 hour)
# CACHE_TTL_SECONDS=3600

# Match confidence threshold (default: 0.75)
# MATCH_CONFIDENCE_THRESHOLD=0.75

# Log level (DEBUG, INFO, WARNING, ERROR)
# LOG_LEVEL=INFO

# Enable undetected-chromedriver (experimental, default: 0)
# GEM_USE_UC=1

# Speed options are off by default, see docs/fast-profile.md