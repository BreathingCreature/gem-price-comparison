# GeM Price Comparison — Environment Variables
# Copy this file to .env and fill in your values.
# Every setting is documented in docs/settings.md.

# Required for anything that calls the LLM (free tier at https://integrate.api.nvidia.com)
NVIDIA_API_KEY=your_key_here

# Optional: override the NVIDIA defaults
# NVIDIA_BASE_URL=https://integrate.api.nvidia.com/v1
# NVIDIA_MODELS=nvidia/nemotron-3-super-120b-a12b
# NVIDIA_MAX_TOKENS=2000
# NVIDIA_MIN_SECONDS_BETWEEN_CALLS=1.6
# NVIDIA_TIMEOUT_SECONDS=90.0

# Optional: more than one provider lives in llm_providers.json (copy the example file)
# LLM_PROVIDERS_FILE=llm_providers.json
# LLM_MAX_WAIT_SECONDS=45.0

# Result cache and matching gates
# CACHE_TTL_SECONDS=3600
# MATCH_CONFIDENCE_THRESHOLD=0.75
# PRICE_SANITY_LOW_RATIO=0.15
# PRICE_SANITY_HIGH_RATIO=5.0

# Speed knobs. These are already the defaults; set them to 0 to go back.
# GEM_PARALLEL=1
# GEM_LLM_WORKERS=4
# GEM_PREFILTER_TOP=10
# GEM_PRICE_PREGATE=1
# GEM_REUSE_VERDICTS=1
# GEM_FLIPKART_LIGHT=1
# GEM_LANE_TIME_LIMIT=150

# Slow, high-recall mode: no filter, every listing to the LLM, one at a time
# GEM_STRICT=1

# Other switches
# GEM_RETRY=1
# GEM_GATES=1
# GEM_DISCOVERY=1
# GEM_DISCOVERY_TIME_LIMIT=25
# GEM_SLIM_REFERENCE=0
# LLM_CACHE=0
# LLM_CACHE_TAG=

# Files, traces and logging
# GEM_TRACE_MAX_FILES=200
# GEM_TRACE_MAX_AGE_DAYS=14
# GEM_DEBUG=0
# LOG_LEVEL=INFO

# Server and demo
# GEM_DEMO=0
# GEM_JOBS=1
# CORS_ORIGINS=

# How long the CLI keeps printing retry updates (seconds); --no-wait exits at once
# GEM_RETRY_CLI_WAIT=120
